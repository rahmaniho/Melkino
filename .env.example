# Runtime API must use a least-privilege PostgreSQL login; never use Supabase service_role here.
DATABASE_URL=postgresql://melkino_login:replace-me@db.example.invalid:5432/postgres?sslmode=require
# Apply migrations with a separate migration/owner role (not the runtime role).
MIGRATION_DATABASE_URL=postgresql://migration_user:replace-me@db.example.invalid:5432/postgres?sslmode=require
# Supabase Auth project dedicated to Melkino. JWT verification uses its published asymmetric JWKS.
SUPABASE_URL=https://your-melkino-project.supabase.co
API_PORT=3001
DB_POOL_MAX=10
# Exact comma-separated frontend HTTPS origin(s), needed only when API is on a separate subdomain.
FRONTEND_ORIGINS=https://melkino.example.com

# Frontend build-time configuration; the Supabase anon/publishable key is public by design.
# Never put a service_role key or database password in any VITE_ variable.
VITE_SUPABASE_URL=https://your-melkino-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-anon-key
VITE_TENANT_ID=00000000-0000-4000-8000-000000000000
VITE_DEFAULT_BRANCH_ID=00000000-0000-4000-8000-000000000000
# Leave at /api/v1 when API is reverse-proxied on the same host; otherwise set e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1
